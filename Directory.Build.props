<Project>
  <PropertyGroup>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <PropertyGroup>
    <!-- This package targets one Umbraco major at a time, as Wayfinder.Umbraco does. UmbracoVersion is the exact
         patch the build compiles and tests against. The Umbraco.Cms.* references use UmbracoPackageRange: that
         patch up to, and not including, the next major. A site on the next major then gets a version conflict at
         restore instead of assemblies built for this one loading against an API they were never tested on. Moving
         to a new major means changing UmbracoMajor and UmbracoVersion together and running every suite. -->
    <UmbracoMajor>17</UmbracoMajor>
    <UmbracoVersion>17.8.1</UmbracoVersion>
    <UmbracoPackageRange>[$(UmbracoVersion), $([MSBuild]::Add($(UmbracoMajor), 1)).0.0)</UmbracoPackageRange>
  </PropertyGroup>
  <ItemGroup>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)CodeMetricsConfig.txt" Visible="false" />
  </ItemGroup>
</Project>
