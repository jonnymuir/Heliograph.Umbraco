<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.6.5" />
    <PackageVersion Include="MessagePack" Version="2.5.307" />
    <!-- The Heliograph engine, its REST API and its workbench, as any site gets them. Prereleases until 0.1.0. -->
    <PackageVersion Include="Heliograph" Version="0.1.0-alpha.11" />
    <PackageVersion Include="Heliograph.Api" Version="0.1.0-alpha.11" />
    <PackageVersion Include="Heliograph.Pdf" Version="0.1.0-alpha.11" />
    <PackageVersion Include="Heliograph.Pdf.LibreOffice" Version="0.1.0-alpha.11" />
    <PackageVersion Include="Heliograph.Workbench" Version="0.1.0-alpha.11" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="Moq" Version="4.21.0" />
    <PackageVersion Include="Umbraco.Cms" Version="$(UmbracoPackageRange)" />
    <PackageVersion Include="Umbraco.Cms.Api.Management" Version="$(UmbracoPackageRange)" />
    <PackageVersion Include="Umbraco.Cms.Core" Version="$(UmbracoPackageRange)" />
    <PackageVersion Include="Umbraco.Cms.DevelopmentMode.Backoffice" Version="$(UmbracoPackageRange)" />
    <PackageVersion Include="Umbraco.Cms.Web.Common" Version="$(UmbracoPackageRange)" />
    <!-- Only the reference site uses Wayfinder. -->
    <PackageVersion Include="Wayfinder.Engine" Version="0.28.0" />
    <PackageVersion Include="Wayfinder.Umbraco.Starter" Version="6.4.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
</Project>
