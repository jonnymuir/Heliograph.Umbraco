<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="Umbraco.Cms" Version="$(UmbracoPackageRange)" />
    <PackageVersion Include="Umbraco.Cms.Api.Management" Version="$(UmbracoPackageRange)" />
    <PackageVersion Include="Umbraco.Cms.Core" Version="$(UmbracoPackageRange)" />
    <PackageVersion Include="Umbraco.Cms.DevelopmentMode.Backoffice" Version="$(UmbracoPackageRange)" />
    <PackageVersion Include="Umbraco.Cms.Web.Common" Version="$(UmbracoPackageRange)" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
</Project>
